# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only (never exposed to the browser)
SUPABASE_SECRET_KEY=paste-secret-or-service-role-key
# on | off  (off in tests)
PASSWORD_BREACH_CHECK=on
# Web Push (free; generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret between the database scheduler and /api/cron/dispatch
CRON_SECRET=
# Optional: TURN relay for partner calls on strict networks (free tiers: Cloudflare Realtime TURN, Metered Open Relay).
# Comma-separate several URLs. Without it, calls use free public STUN and work on most networks.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
